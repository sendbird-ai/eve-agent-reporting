{
  "name": "@bshaan77/eve-agent-reporting",
  "version": "1.0.0",
  "description": "Configurable reporting and optional reusable agent components",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "build:components": "npm run build --workspaces",
    "typecheck:components": "npm run typecheck --workspaces",
    "test:components": "npm run test --workspaces",
    "check:all": "npm run check && npm run typecheck:components && npm run test:components && npm run test:audit && npm run audit:public",
    "pack:candidates": "node scripts/pack-candidates.mjs",
    "audit:public": "npm run build --workspace @bshaan77/eve-agent-quality && node scripts/audit-public.mjs .",
    "smoke:installed": "node scripts/smoke-installed.mjs",
    "test:audit": "node --test scripts/test-audit.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendbird-ai/eve-agent-reporting.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
