{
  "name": "@bshaan77/eve-agent-reporting",
  "version": "0.2.0",
  "description": "Shared reporting client for Sendbird eve agents — standardized usage/audience event reporting to the Automators dashboard.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "access:prepare": "node scripts/access-artifact/prepare.mjs",
    "access:verify": "node scripts/access-artifact/verify.mjs",
    "test:access-artifact": "node --test test/access-artifact/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendbird-ai/eve-agent-reporting.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
